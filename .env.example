# Konfigurasi MQTT Broker
# ⚠️ PENTING untuk Railway: JANGAN pakai tanda kutip di nilai variabel!
MQTT_URL=mqtt://mqtt-cleen.ptpjb.com
MQTT_PORT=1883
MQTT_USERNAME=bbtk
MQTT_PASSWORD=ebtbbtk@PJB

# Prefix topik yang disubscribe (wildcard) — TANPA tanda kutip di Railway
MQTT_TOPIC=KPPJBS/PLTD_Suppa/#

# Port web server (Railway akan override PORT via environment variable)
PORT=3000
