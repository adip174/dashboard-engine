# MQTT Bridge (Node.js Alternative)
# Simpan sebagai .env.bridge di folder yang sama dengan mqtt-bridge.js

# ===== Broker PJB (Sumber Data) =====
BROKER_PJB_URL=mqtt://mqtt-cleen.ptpjb.com
BROKER_PJB_PORT=1883
BROKER_PJB_USERNAME=bbtk
BROKER_PJB_PASSWORD=ebtbbtk@PJB

# ===== HiveMQ Cloud (Tujuan) =====
HIVEMQ_HOST=xxx.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_USERNAME=railway-dashboard
HIVEMQ_PASSWORD=password-yang-anda-buat

# ===== Topic =====
MQTT_TOPIC=KPPJBS/PLTD_Suppa/#
